# Copie este arquivo para .env.local e preencha.

# Supabase > Project Settings > API (ou "API Keys")
# A chave "anon" (legacy) ou a nova "publishable" (sb_publishable_...) funcionam aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Anthropic (opcional). Sem ela, o chat e a proposta usam respostas/templates automáticos.
ANTHROPIC_API_KEY=
# Modelo usado nas rotas /api/ai/* (pode trocar sem mexer no código)
ANTHROPIC_MODEL=claude-haiku-4-5
